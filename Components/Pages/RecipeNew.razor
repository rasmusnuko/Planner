@page "/recipes/new"
@attribute [Authorize]
@inject RecipeService         RecipeSvc
@inject RecipeScraperService  ScraperSvc
@inject NavigationManager     Nav

<PageTitle>New recipe – HomePlanner</PageTitle>

<div class="page">
    <div class="page-header">
        <div class="page-header-left">
            <div class="page-title">New recipe</div>
        </div>
        <a href="/recipes" class="btn btn-ghost btn-sm">← Back</a>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-error">@_error</div>
    }
    @if (_importSuccess)
    {
        <div class="alert alert-success">Recipe imported! Review the details below and save.</div>
    }

    <!-- Import from URL -->
    <div class="card mb-2">
        <div class="card-header"><span class="card-title">Import from URL</span></div>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group" style="flex:3;min-width:200px">
                    <label>Recipe URL</label>
                    <input type="url" @bind="_importUrl" placeholder="https://www.bbcgoodfood.com/recipes/…" />
                </div>
                <div class="form-group" style="display:flex;align-items:flex-end">
                    <button class="btn btn-secondary" @onclick="ImportAsync" disabled="@_importing">
                        @if (_importing) { <span>Importing…</span> } else { <span>Import</span> }
                    </button>
                </div>
            </div>
            <div class="text-muted text-xs">
                Works with most recipe sites that use Schema.org markup (BBC Good Food, AllRecipes, Food Network, Tasty, etc.)
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="form-group">
                <label>Recipe name *</label>
                <input type="text" @bind="_title" placeholder="e.g. Spaghetti Bolognese" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Prep time (minutes)</label>
                    <input type="number" @bind="_prepTime" min="1" placeholder="30" />
                </div>
                <div class="form-group">
                    <label>Servings</label>
                    <input type="number" @bind="_servings" min="1" placeholder="4" />
                </div>
            </div>
            <div class="form-group">
                <label>Short description</label>
                <textarea @bind="_description" rows="2" placeholder="A quick description of the dish…"></textarea>
            </div>
            <div class="form-group">
                <label>Ingredients (one per line)</label>
                <textarea @bind="_ingredients" rows="6" placeholder="200g pasta&#10;1 onion&#10;2 cloves garlic"></textarea>
            </div>
            <div class="form-group">
                <label>Instructions</label>
                <textarea @bind="_instructions" rows="8" placeholder="Step by step instructions…"></textarea>
            </div>
            <div class="form-group">
                <label>Source URL</label>
                <input type="url" @bind="_sourceUrl" placeholder="https://…" />
            </div>
            <div class="flex gap-1">
                <button class="btn btn-primary" @onclick="SaveAsync">Save recipe</button>
                <a href="/recipes" class="btn btn-ghost">Cancel</a>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _title        = "";
    private string _description  = "";
    private string _ingredients  = "";
    private string _instructions = "";
    private int?   _prepTime;
    private int?   _servings;
    private string _sourceUrl   = "";
    private string _importUrl   = "";
    private bool   _importing;
    private bool   _importSuccess;
    private string? _error;
    private int _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            var id = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(id, out var uid)) _currentUserId = uid;
        }
    }

    private async Task ImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_importUrl)) return;
        _importing     = true;
        _error         = null;
        _importSuccess = false;
        try
        {
            var scraped    = await ScraperSvc.ScrapeAsync(_importUrl.Trim());
            _title         = scraped.Title;
            _description   = scraped.Description ?? "";
            _ingredients   = string.Join('\n', scraped.Ingredients);
            _instructions  = scraped.Instructions ?? "";
            _prepTime      = scraped.PrepTime;
            _servings      = scraped.Servings;
            _sourceUrl     = scraped.SourceUrl;
            _importSuccess = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_title))
        {
            _error = "Title is required.";
            return;
        }
        var recipe = new Recipe
        {
            Title        = _title.Trim(),
            Description  = string.IsNullOrWhiteSpace(_description)  ? null : _description.Trim(),
            Ingredients  = _ingredients.Split('\n', StringSplitOptions.RemoveEmptyEntries)
                               .Select(s => s.Trim()).Where(s => s.Length > 0).ToList(),
            Instructions = string.IsNullOrWhiteSpace(_instructions) ? null : _instructions.Trim(),
            PrepTime     = _prepTime,
            Servings     = _servings,
            SourceUrl    = string.IsNullOrWhiteSpace(_sourceUrl)    ? null : _sourceUrl.Trim(),
            CreatedById  = _currentUserId
        };
        var saved = await RecipeSvc.CreateAsync(recipe);
        Nav.NavigateTo($"/recipes/{saved.Id}");
    }
}
