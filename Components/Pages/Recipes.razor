@page "/recipes"
@attribute [Authorize]
@inject RecipeService RecipeSvc

<PageTitle>Recipes – HomePlanner</PageTitle>

<div class="page">
    <div class="page-header">
        <div class="page-header-left">
            <div class="page-title">Recipes</div>
            <div class="page-subtitle">@_recipes.Count recipe@(_recipes.Count != 1 ? "s" : "")</div>
        </div>
        <a href="/recipes/new" class="btn btn-primary btn-sm">+ New recipe</a>
    </div>

    <!-- Search -->
    <div class="input-row mb-2">
        <input type="text" @bind="_query" @onkeyup="HandleSearch" placeholder="Search recipes…" />
        <button class="btn btn-secondary" @onclick="SearchAsync">Search</button>
        @if (!string.IsNullOrEmpty(_query))
        {
            <button class="btn btn-ghost" @onclick="ClearSearch">Clear</button>
        }
    </div>

    @if (_recipes.Count == 0)
    {
        <div class="empty-state">
            @(string.IsNullOrEmpty(_query) ? "No recipes yet. Add your first one!" : $"No recipes matching \"{_query}\".")
        </div>
    }
    else
    {
        <div class="recipe-grid">
            @foreach (var r in _recipes)
            {
                <a href="/recipes/@r.Id" class="recipe-card">
                    <div class="recipe-card-title">@r.Title</div>
                    <div class="recipe-card-meta" style="margin-top:0.4rem">
                        @if (r.PrepTime.HasValue) { <span>⏱ @r.PrepTime min</span> }
                        @if (r.Servings.HasValue) { <span style="margin-left:0.5rem">👥 @r.Servings</span> }
                    </div>
                    @if (!string.IsNullOrEmpty(r.Description))
                    {
                        <div class="text-sm text-muted" style="margin-top:0.5rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                            @r.Description
                        </div>
                    }
                    @if (r.CreatedBy is not null)
                    {
                        <div class="text-xs text-muted" style="margin-top:0.5rem">By @r.CreatedBy.DisplayName</div>
                    }
                </a>
            }
        </div>
    }
</div>

@code {
    private List<Recipe> _recipes = [];
    private string _query = "";

    protected override async Task OnInitializedAsync() => await SearchAsync();

    private async Task SearchAsync()
    {
        _recipes = await RecipeSvc.GetAllAsync(string.IsNullOrWhiteSpace(_query) ? null : _query);
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private async Task ClearSearch()
    {
        _query = "";
        await SearchAsync();
    }
}
