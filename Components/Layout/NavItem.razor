@* Thin wrapper around NavLink that keeps the same CSS class structure *@

<NavLink href="@Href"
         class="nav-link"
         ActiveClass="active"
         Match="@(Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)"
         @onclick="OnClick">
    <span style="font-size:1rem;line-height:1">@Icon</span>
    @Label
</NavLink>

@code {
    [Parameter, EditorRequired] public string Href  { get; set; } = "/";
    [Parameter, EditorRequired] public string Icon  { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Exact { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
